# Pravyo — environment configuration
# Copy to `.env.local` for local development. In production these must be set
# in the Vercel dashboard (.env.local is NOT deployed), and changing any of
# them requires a redeploy before it takes effect.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/pravyo?appName=Cluster0

# Canonical origin of this deployment. NextAuth uses it for callback URLs and
# to decide whether to write secure (`__Secure-`) session cookies, so it must
# match the browser-visible origin exactly (no trailing slash).
#   local: http://localhost:3000
NEXTAUTH_URL=https://pravyo.infobytesnepal.com

# Session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public site origin, baked into the client bundle. Feeds canonical/OpenGraph
# metadata, robots.txt, sitemap.xml, email links, and the verification URL
# printed on certificates. Must be the live origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://pravyo.infobytesnepal.com

# Support address shown publicly on /contact, /privacy and /terms. Also baked
# into the client bundle, so a change needs a rebuild, not just a restart. Keep
# this an official address — it is displayed to every visitor.
NEXT_PUBLIC_SUPPORT_EMAIL=contact@pravyo.infobytesnepal.com

# ---------------------------------------------------------------------------
# Optional — each feature degrades gracefully when unset
# ---------------------------------------------------------------------------

# --- Transactional email -----------------------------------------------------
# Two transports are supported. SMTP wins when SMTP_HOST/SMTP_USER/SMTP_PASSWORD
# are all set; otherwise Resend is used; with neither, sends are skipped with a
# warning and the app keeps working.
#
# Zoho Mail (paid plan — the free plan blocks SMTP entirely):
#   SMTP_HOST=smtppro.zoho.com     (custom domain; use smtp.zoho.com for a
#                                   personal @zohomail.com address, and the
#                                   .in/.eu/.com.au variant if your Zoho account
#                                   lives in that datacenter)
#   SMTP_PORT=465                  (implicit TLS; use 587 for STARTTLS)
#
# Zoho ZeptoMail (transactional product; free 10k-email credit):
#   SMTP_HOST=smtp.zeptomail.com
#   SMTP_PORT=465
#   SMTP_USER=emailapikey
#   SMTP_PASSWORD=<the Send Mail token from the ZeptoMail console>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Envelope sender. Zoho rejects a From address that isn't the authenticated
# mailbox or one of its verified aliases, so leave this equal to SMTP_USER
# unless you have set up an alias. Defaults to SMTP_USER when unset.
MAIL_FROM=confirmation@pravyo.infobytesnepal.com
MAIL_FROM_NAME=Pravyo

# Resend — used when SMTP_* above is not configured. Its free tier (3,000
# emails/month, 100/day, 1 verified domain) is the zero-cost option and is
# plenty for approval mail; Zoho Mail's free plan cannot send from an app at
# all. Set MAIL_FROM above to your verified-domain sender when using this.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Upstash Redis, used for cross-instance rate limiting and the realtime bus.
# Unset, both fall back to per-instance in-memory state — fine for a single
# process, but on serverless each instance keeps its own counters, so rate
# limits are effectively multiplied by the instance count.
# REALTIME_REDIS_REST_URL / REALTIME_REDIS_REST_TOKEN are accepted as aliases if
# you would rather name them that way; the UPSTASH_* pair takes precedence.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# First-run admin bootstrap (development only)
# ---------------------------------------------------------------------------

# When the database has no SUPER_ADMIN, one is auto-created from these. This is
# blocked in production on purpose — create the first admin there via
# POST /api/admin/bootstrap instead.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Super Admin

# Token guarding POST /api/admin/bootstrap. The endpoint is fail-closed: while
# this is unset it returns 403 and no admin can be created through it. Set it
# only for the one-time first-admin setup, then clear it and redeploy.
SUPER_ADMIN_BOOTSTRAP_TOKEN=

# Escape hatch that lets the auto-seed above run in production. Leave unset;
# setting it to "true" creates an admin with known credentials on a live site.
ALLOW_ADMIN_SEED_IN_PRODUCTION=
